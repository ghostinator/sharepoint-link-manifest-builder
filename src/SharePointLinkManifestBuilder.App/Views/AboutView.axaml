<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SharePointLinkManifestBuilder.App.ViewModels"
             x:Class="SharePointLinkManifestBuilder.App.Views.AboutView"
             x:DataType="vm:AboutViewModel">

  <ScrollViewer>
    <StackPanel Margin="24" Spacing="8" MaxWidth="820" HorizontalAlignment="Left">

      <TextBlock Text="About" Classes="PageTitle" />

      <Border Classes="Warning" IsVisible="{Binding HasPlaceholders}">
        <StackPanel Spacing="4">
          <TextBlock Text="This build has placeholder publisher details" FontWeight="SemiBold" />
          <TextBlock Text="{Binding PlaceholderNotice}" Classes="Body" />
        </StackPanel>
      </Border>

      <Border Classes="Card">
        <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Product" Classes="Subtle" />
          <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Product.ProductName}" />

          <TextBlock Grid.Row="1" Grid.Column="0" Text="Version" Classes="Subtle" />
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Version}" />

          <TextBlock Grid.Row="2" Grid.Column="0" Text="Publisher" Classes="Subtle" />
          <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Product.Publisher}" />

          <TextBlock Grid.Row="3" Grid.Column="0" Text="Runtime" Classes="Subtle" />
          <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Runtime}" />

          <TextBlock Grid.Row="4" Grid.Column="0" Text="Platform" Classes="Subtle" />
          <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Platform}" TextWrapping="Wrap" />

          <TextBlock Grid.Row="5" Grid.Column="0" Text="Homepage" Classes="Subtle" />
          <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Product.HomepageUrl}" Classes="Mono" />

          <TextBlock Grid.Row="6" Grid.Column="0" Text="Privacy policy" Classes="Subtle" />
          <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Product.PrivacyPolicyUrl}" Classes="Mono" />

          <TextBlock Grid.Row="7" Grid.Column="0" Text="Source code" Classes="Subtle" />
          <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Product.SourceCodeUrl}" Classes="Mono" />

          <TextBlock Grid.Row="8" Grid.Column="0" Text="Contact" Classes="Subtle" />
          <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding Product.ContactAddress}" Classes="Mono" />
        </Grid>
      </Border>

      <TextBlock Text="Updates" Classes="SectionTitle" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Check for updates" Command="{Binding CheckForUpdatesCommand}" />
        <TextBlock Text="{Binding UpdateCheckResult}" VerticalAlignment="Center" TextWrapping="Wrap"
                   MaxWidth="520" AutomationProperties.LiveSetting="Polite" />
      </StackPanel>
      <TextBlock Classes="Subtle" FontSize="11"
                 Text="This application never downloads or installs an update by itself." />

      <TextBlock Text="Third-party components" Classes="SectionTitle" />
      <ItemsControl ItemsSource="{Binding ThirdPartyComponents}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="280,100,*" Margin="0,2">
              <TextBlock Grid.Column="0" Text="{Binding Component}" />
              <TextBlock Grid.Column="1" Text="{Binding Licence}" Classes="Subtle" />
              <TextBlock Grid.Column="2" Text="{Binding Purpose}" Classes="Subtle" TextWrapping="Wrap" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Classes="Subtle" FontSize="11"
                 Text="A full dependency inventory and licence list is in THIRD-PARTY-NOTICES.md, and a software bill of materials is produced for each release." />

      <TextBlock Text="{Binding StatusMessage}" Classes="Subtle"
                 IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
