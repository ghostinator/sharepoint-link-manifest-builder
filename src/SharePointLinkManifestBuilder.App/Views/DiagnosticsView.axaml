<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SharePointLinkManifestBuilder.App.ViewModels"
             x:Class="SharePointLinkManifestBuilder.App.Views.DiagnosticsView"
             x:DataType="vm:DiagnosticsViewModel">

  <ScrollViewer>
    <StackPanel Margin="24" Spacing="8" MaxWidth="900" HorizontalAlignment="Left">

      <TextBlock Text="Diagnostics" Classes="PageTitle" />

      <TextBlock Text="{Binding StatusMessage}" Classes="Subtle"
                 IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 AutomationProperties.LiveSetting="Polite" />
      <Border Classes="Danger" IsVisible="{Binding HasError}">
        <TextBlock Text="{Binding ErrorMessage}" Classes="Body" />
      </Border>

      <Border Classes="Card">
        <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Application version" Classes="Subtle" />
          <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Version}" />

          <TextBlock Grid.Row="1" Grid.Column="0" Text="Platform" Classes="Subtle" />
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Platform}" TextWrapping="Wrap" />

          <TextBlock Grid.Row="2" Grid.Column="0" Text="Architecture" Classes="Subtle" />
          <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Architecture}" />

          <TextBlock Grid.Row="3" Grid.Column="0" Text="Runtime" Classes="Subtle" />
          <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding RuntimeVersion}" />

          <TextBlock Grid.Row="4" Grid.Column="0" Text="Connection" Classes="Subtle" />
          <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ConnectionStateDisplay}" />

          <TextBlock Grid.Row="5" Grid.Column="0" Text="Registration / consent" Classes="Subtle" />
          <TextBlock Grid.Row="5" Grid.Column="1">
            <TextBlock.Text>
              <MultiBinding StringFormat="{}{0} / {1}">
                <Binding Path="RegistrationDisplay" />
                <Binding Path="ConsentDisplay" />
              </MultiBinding>
            </TextBlock.Text>
          </TextBlock>

          <TextBlock Grid.Row="6" Grid.Column="0" Text="Secure storage" Classes="Subtle" />
          <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SecureStorageDisplay}" />
        </Grid>
      </Border>

      <TextBlock Text="Connectivity" Classes="SectionTitle" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Test Microsoft Graph connectivity" Command="{Binding TestConnectivityCommand}" />
        <TextBlock Text="{Binding ConnectivityResult}" VerticalAlignment="Center"
                   AutomationProperties.LiveSetting="Polite" />
      </StackPanel>

      <TextBlock Text="Most recent job" Classes="SectionTitle" />
      <TextBlock Text="{Binding LastJobSummary}" Classes="Body" />

      <TextBlock Text="Sanitized recent errors" Classes="SectionTitle" />
      <TextBlock Classes="Subtle" Text="No errors have been recorded." IsVisible="{Binding !RecentErrors.Count}" />
      <Border Classes="Card" IsVisible="{Binding RecentErrors.Count}">
        <ItemsControl ItemsSource="{Binding RecentErrors}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Text="{Binding}" Classes="Mono" Margin="0,2" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <TextBlock Text="Diagnostic bundle" Classes="SectionTitle" />
      <Border Classes="Card">
        <StackPanel Spacing="8">
          <TextBlock Classes="Body"
                     Text="Exactly what a bundle contains is listed below. Nothing outside these categories is written." />

          <TextBlock Text="Always included" FontWeight="SemiBold" />
          <ItemsControl ItemsSource="{Binding AlwaysIncluded}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Text="{Binding}" Classes="Body" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="Never included, under any option" FontWeight="SemiBold" Margin="0,8,0,0" />
          <ItemsControl ItemsSource="{Binding NeverIncluded}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Text="{Binding}" Classes="Body" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="Include only if you approve" FontWeight="SemiBold" Margin="0,8,0,0" />
          <CheckBox Content="File and folder names" IsChecked="{Binding IncludeFileNames}" />
          <CheckBox Content="Email addresses and user principal names" IsChecked="{Binding IncludeEmailAddresses}" />
          <CheckBox Content="Full tenant-specific URLs and identifiers" IsChecked="{Binding IncludeFullUrls}" />

          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <Button Content="Export diagnostic bundle" Classes="Primary" Command="{Binding ExportBundleCommand}" />
            <Button Content="Open exports folder" Command="{Binding OpenExportsFolderCommand}" />
          </StackPanel>

          <TextBlock Text="{Binding LastBundlePath}" Classes="Mono"
                     IsVisible="{Binding LastBundlePath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </Border>

      <WrapPanel Margin="0,8,0,0">
        <Button Content="Open log folder" Margin="0,0,8,8" Command="{Binding OpenLogFolderCommand}" />
        <Button Content="Clear local cache" Margin="0,0,8,8" Command="{Binding ClearCacheCommand}" />
        <Button Content="Clear job history" Margin="0,0,8,8" Command="{Binding ClearHistoryCommand}" />
      </WrapPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
