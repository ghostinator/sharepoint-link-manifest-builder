<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SharePointLinkManifestBuilder.App.ViewModels"
             xmlns:models="using:SharePointLinkManifestBuilder.Core.Models"
             x:Class="SharePointLinkManifestBuilder.App.Views.SharePointBrowserView"
             x:DataType="vm:SharePointBrowserViewModel">

  <!-- One scroll region for the whole browser, with the action bar pinned outside it.
       Bounding each part separately (a cap on the controls, a floor under the tree, a third
       scroll for the side panel) put three scrollbars in competition for one gesture and left
       every region cramped at once. Letting the content take its natural height and scrolling
       the lot is simpler and gives each part the room it asks for. The action bar stays out of
       the scroll so the primary action is reachable without scrolling back to find it. -->
  <Grid RowDefinitions="*,Auto">

    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
      <StackPanel Spacing="12">

      <StackPanel Spacing="4">
      <TextBlock Text="SharePoint Sites" Classes="PageTitle" />
      <TextBlock Classes="Subtle"
                 Text="Expand a site to its document libraries, then into folders. Tick anything you want to process." />

      </StackPanel>

      <StackPanel Spacing="8">

      <!-- Search scope honesty notice: the index is not the whole tenant. -->
      <Border Classes="Notice">
        <TextBlock Text="{Binding SearchScopeNotice}" Classes="Body" />
      </Border>

      <Grid ColumnDefinitions="*,Auto,Auto,Auto">
        <TextBox Grid.Column="0" Text="{Binding SearchQuery}"
                 PlaceholderText="Search sites by name"
                 AutomationProperties.Name="Search SharePoint sites">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
        <Button Grid.Column="1" Content="Search" Margin="8,0,0,0" Command="{Binding SearchCommand}" />
        <Button Grid.Column="2" Content="Refresh" Margin="8,0,0,0" Command="{Binding RefreshCommand}" />
        <ProgressBar Grid.Column="3" IsIndeterminate="True" Width="80" Margin="8,0,0,0"
                     IsVisible="{Binding IsBusy}"
                     AutomationProperties.Name="Loading" />
      </Grid>

      <Grid ColumnDefinitions="*,Auto">
        <TextBox Grid.Column="0" Text="{Binding PastedUrl}"
                 PlaceholderText="Or paste a SharePoint site, library or folder URL"
                 AutomationProperties.Name="Paste a SharePoint URL">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding OpenPastedUrlCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
        <Button Grid.Column="1" Content="Open URL" Margin="8,0,0,0"
                Command="{Binding OpenPastedUrlCommand}" />
      </Grid>

      <Border Classes="Danger" IsVisible="{Binding HasError}">
        <TextBlock Text="{Binding ErrorMessage}" Classes="Body"
                   AutomationProperties.LiveSetting="Assertive" />
      </Border>

      <TextBlock Text="{Binding StatusMessage}" Classes="Subtle"
                 IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 AutomationProperties.LiveSetting="Polite" />
    </StackPanel>


      <Grid ColumnDefinitions="*,Auto">

        <Border Grid.Column="0" Classes="Card" Padding="4">
          <TreeView ItemsSource="{Binding Roots}"
                    SelectedItem="{Binding SelectedNode}"
                    AutomationProperties.Name="SharePoint resource tree">
            <TreeView.Styles>
              <!-- Without this the view model never learns that the user expanded a node, so
                   OnIsExpandedChanged never fires, EnsureChildrenLoadedAsync is never called,
                   and the node shows its "Loading..." placeholder forever. The container owns
                   the expansion state; the binding is what hands it to the view model. -->
              <Style Selector="TreeViewItem" x:DataType="vm:ResourceNodeViewModel">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
              </Style>
            </TreeView.Styles>
            <TreeView.ItemTemplate>
              <TreeDataTemplate ItemsSource="{Binding Children}" DataType="vm:ResourceNodeViewModel">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,2">
                  <CheckBox Grid.Column="0"
                            IsChecked="{Binding IsChecked}"
                            IsThreeState="True"
                            IsVisible="{Binding CanBeTarget}"
                            AutomationProperties.Name="{Binding AccessibleName}"
                            VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Glyph}" Margin="4,0"
                             VerticalAlignment="Center" />
                  <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayName}"
                               AutomationProperties.Name="{Binding AccessibleName}" />
                    <TextBlock Text="{Binding Description}" Classes="Subtle" FontSize="11"
                               IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               TextTrimming="CharacterEllipsis" MaxWidth="420" />
                    <TextBlock Text="{Binding LoadError}" Foreground="IndianRed" FontSize="11"
                               IsVisible="{Binding LoadError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               TextWrapping="Wrap" MaxWidth="420" />
                  </StackPanel>
                  <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
                    <ProgressBar IsIndeterminate="True" Width="60" Height="4"
                                 IsVisible="{Binding IsLoading}"
                                 AutomationProperties.Name="Loading folder contents" />
                    <Button Content="Retry" FontSize="11" Padding="6,2"
                            IsVisible="{Binding CanRetry}"
                            Command="{Binding $parent[TreeView].((vm:SharePointBrowserViewModel)DataContext).RetryNodeCommand}"
                            CommandParameter="{Binding}" />
                  </StackPanel>
                </Grid>
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </Border>

        <StackPanel Spacing="8">

          <Border Classes="Card">
            <StackPanel Spacing="6">
              <TextBlock Text="Selected item" Classes="SectionTitle" Margin="0" />
              <TextBlock Classes="Subtle" Text="Nothing selected."
                         IsVisible="{Binding SelectedNode, Converter={x:Static ObjectConverters.IsNull}}" />

              <StackPanel Spacing="4"
                          IsVisible="{Binding SelectedNode, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Text="{Binding SelectedNode.DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding SelectedNode.WebUrl}" Classes="Subtle" TextWrapping="Wrap" FontSize="11" />

                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                  <Button Content="Add as target" Classes="Primary"
                          Command="{Binding AddNodeAsTargetCommand}"
                          CommandParameter="{Binding SelectedNode}" />
                  <Button Content="Open" Command="{Binding OpenInBrowserCommand}"
                          CommandParameter="{Binding SelectedNode}" />
                  <Button Content="Copy URL" Command="{Binding CopyWebUrlCommand}"
                          CommandParameter="{Binding SelectedNode}" />
                </StackPanel>

                <!-- Identifiers are available but never required: friendly names drive the UI. -->
                <Expander Header="Advanced details" Margin="0,8,0,0"
                          IsExpanded="{Binding ShowAdvancedDetails}">
                  <StackPanel Spacing="4">
                    <TextBlock Text="These identifiers are shown for troubleshooting. You never need to copy them."
                               Classes="Subtle" FontSize="11" />
                    <TextBlock Classes="Mono" Text="{Binding SelectedNode.SiteId, StringFormat='Site ID: {0}'}" />
                    <TextBlock Classes="Mono" Text="{Binding SelectedNode.DriveId, StringFormat='Drive ID: {0}'}" />
                    <TextBlock Classes="Mono" Text="{Binding SelectedNode.ItemId, StringFormat='Item ID: {0}'}" />
                    <TextBlock Classes="Mono" Text="{Binding SelectedNode.RelativePath, StringFormat='Path: {0}'}" />
                  </StackPanel>
                </Expander>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Classes="Card" IsVisible="{Binding PinnedLocations.Count}">
            <StackPanel Spacing="4">
              <TextBlock Text="Pinned locations" Classes="SectionTitle" Margin="0" />
              <ItemsControl ItemsSource="{Binding PinnedLocations}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="models:RecentLocation">
                    <Button Content="{Binding DisplayName}" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left" Margin="0,2"
                            Command="{Binding $parent[ItemsControl].((vm:SharePointBrowserViewModel)DataContext).OpenLocationCommand}"
                            CommandParameter="{Binding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Classes="Card" IsVisible="{Binding RecentLocations.Count}">
            <StackPanel Spacing="4">
              <TextBlock Text="Recent locations" Classes="SectionTitle" Margin="0" />
              <ItemsControl ItemsSource="{Binding RecentLocations}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="models:RecentLocation">
                    <Button Content="{Binding DisplayName}" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left" Margin="0,2"
                            Command="{Binding $parent[ItemsControl].((vm:SharePointBrowserViewModel)DataContext).OpenLocationCommand}"
                            CommandParameter="{Binding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

        </StackPanel>

      </Grid>

      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="1" Classes="Card" Margin="0,12,0,0" Padding="4">
        <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="4"
                   Margin="8,10,8,8">
          <CheckBox Content="Include subfolders" IsChecked="{Binding IncludeSubfolders}"
                    ToolTip.Tip="Applies to targets added from this page. It can be changed per target later." />
          <Button Content="Add selected as targets" Classes="Primary"
                  Command="{Binding AddSelectedAsTargetsCommand}" />
          <Button Content="Select all visible" Command="{Binding SelectAllVisibleCommand}" />
          <Button Content="Clear selection" Command="{Binding ClearSelectionCommand}" />
          <TextBlock VerticalAlignment="Center" Classes="Subtle"
                     Text="{Binding TargetCount, StringFormat='{}{0} target(s) in job'}" />
        </WrapPanel>
    </Border>
  </Grid>
</UserControl>
