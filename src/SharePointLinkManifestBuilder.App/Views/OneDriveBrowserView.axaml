<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SharePointLinkManifestBuilder.App.ViewModels"
             xmlns:models="using:SharePointLinkManifestBuilder.Core.Models"
             x:Class="SharePointLinkManifestBuilder.App.Views.OneDriveBrowserView"
             x:DataType="vm:OneDriveBrowserViewModel">

  <!-- One scroll region for the whole browser, with the action bar pinned outside it.
       Bounding each part separately (a cap on the controls, a floor under the tree, a third
       scroll for the side panel) put three scrollbars in competition for one gesture and left
       every region cramped at once. Letting the content take its natural height and scrolling
       the lot is simpler and gives each part the room it asks for. The action bar stays out of
       the scroll so the primary action is reachable without scrolling back to find it. -->
  <Grid RowDefinitions="*,Auto">

    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
      <StackPanel Spacing="12">

      <StackPanel Spacing="4">
      <TextBlock Text="OneDrive" Classes="PageTitle" />
      <TextBlock Classes="Subtle"
                 Text="Browse your own OneDrive, or another user's where your permissions allow it." />

      </StackPanel>

      <StackPanel Spacing="8">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Open My OneDrive" Classes="Primary" Command="{Binding LoadMyDriveCommand}" />
        <ProgressBar IsIndeterminate="True" Width="80" IsVisible="{Binding IsBusy}"
                     AutomationProperties.Name="Loading" />
      </StackPanel>

      <Expander Header="Open another user's OneDrive">
        <StackPanel Spacing="8" Margin="0,8">

          <Border Classes="Notice">
            <TextBlock Text="{Binding UserDriveNotice}" Classes="Body" />
          </Border>

          <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBox Grid.Column="0" Text="{Binding UserSearchQuery}"
                     PlaceholderText="Search for a user by name or sign-in address"
                     AutomationProperties.Name="Search for a user">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding SearchUsersCommand}" />
              </TextBox.KeyBindings>
            </TextBox>
            <Button Grid.Column="1" Content="Search" Margin="8,0,0,0"
                    Command="{Binding SearchUsersCommand}" />
            <ProgressBar Grid.Column="2" IsIndeterminate="True" Width="60" Margin="8,0,0,0"
                         IsVisible="{Binding IsSearchingUsers}"
                         AutomationProperties.Name="Searching for users" />
          </Grid>

          <ListBox ItemsSource="{Binding UserResults}" SelectedItem="{Binding SelectedUser}"
                   MaxHeight="180" AutomationProperties.Name="User search results">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="models:OneDriveUser">
                <StackPanel Margin="0,2">
                  <TextBlock Text="{Binding DisplayName}" />
                  <TextBlock Text="{Binding UserPrincipalName}" Classes="Subtle" FontSize="11" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Button Content="Open selected user's OneDrive" Command="{Binding OpenUserDriveCommand}" />

          <Border Classes="Warning"
                  IsVisible="{Binding UserDriveUnavailableReason, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <StackPanel Spacing="4">
              <TextBlock Text="That OneDrive could not be opened" FontWeight="SemiBold" />
              <TextBlock Text="{Binding UserDriveUnavailableReason}" Classes="Body" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Expander>

      <Border Classes="Danger" IsVisible="{Binding HasError}">
        <TextBlock Text="{Binding ErrorMessage}" Classes="Body"
                   AutomationProperties.LiveSetting="Assertive" />
      </Border>

      <TextBlock Text="{Binding StatusMessage}" Classes="Subtle"
                 IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 AutomationProperties.LiveSetting="Polite" />
    </StackPanel>


      <Grid ColumnDefinitions="*,Auto">

        <Border Grid.Column="0" Classes="Card" Padding="4">
          <TreeView ItemsSource="{Binding Roots}" SelectedItem="{Binding SelectedNode}"
                    AutomationProperties.Name="OneDrive resource tree">
            <TreeView.Styles>
              <!-- Without this the view model never learns that the user expanded a node, so
                   OnIsExpandedChanged never fires, EnsureChildrenLoadedAsync is never called,
                   and the node shows its "Loading..." placeholder forever. The container owns
                   the expansion state; the binding is what hands it to the view model. -->
              <Style Selector="TreeViewItem" x:DataType="vm:ResourceNodeViewModel">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
              </Style>
            </TreeView.Styles>
            <TreeView.ItemTemplate>
              <TreeDataTemplate ItemsSource="{Binding Children}" DataType="vm:ResourceNodeViewModel">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,2">
                  <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked}" IsThreeState="True"
                            IsVisible="{Binding CanBeTarget}"
                            AutomationProperties.Name="{Binding AccessibleName}"
                            VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Glyph}" Margin="4,0" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayName}"
                               AutomationProperties.Name="{Binding AccessibleName}" />
                    <TextBlock Text="{Binding Description}" Classes="Subtle" FontSize="11"
                               IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               TextTrimming="CharacterEllipsis" MaxWidth="420" />
                    <TextBlock Text="{Binding LoadError}" Foreground="IndianRed" FontSize="11"
                               IsVisible="{Binding LoadError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               TextWrapping="Wrap" MaxWidth="420" />
                  </StackPanel>
                  <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
                    <ProgressBar IsIndeterminate="True" Width="60" Height="4"
                                 IsVisible="{Binding IsLoading}"
                                 AutomationProperties.Name="Loading folder contents" />
                    <Button Content="Retry" FontSize="11" Padding="6,2" IsVisible="{Binding CanRetry}"
                            Command="{Binding $parent[TreeView].((vm:OneDriveBrowserViewModel)DataContext).RetryNodeCommand}"
                            CommandParameter="{Binding}" />
                    <Button Content="Close" FontSize="11" Padding="6,2" IsVisible="{Binding IsRoot}"
                            ToolTip.Tip="Close this OneDrive. Targets already added from it are kept."
                            AutomationProperties.Name="Close this OneDrive"
                            Command="{Binding $parent[TreeView].((vm:OneDriveBrowserViewModel)DataContext).CloseDriveCommand}"
                            CommandParameter="{Binding}" />
                  </StackPanel>
                </Grid>
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </Border>

        <Border Grid.Column="1" Classes="Card" VerticalAlignment="Top"
                MaxWidth="320" MinWidth="220" Margin="12,0,0,0">
        <StackPanel Spacing="6">
          <TextBlock Text="Selected item" Classes="SectionTitle" Margin="0" />
          <TextBlock Classes="Subtle" Text="Nothing selected."
                     IsVisible="{Binding SelectedNode, Converter={x:Static ObjectConverters.IsNull}}" />

          <StackPanel Spacing="4"
                      IsVisible="{Binding SelectedNode, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding SelectedNode.DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding SelectedNode.WebUrl}" Classes="Subtle" TextWrapping="Wrap" FontSize="11" />

            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
              <Button Content="Add as target" Classes="Primary"
                      Command="{Binding AddNodeAsTargetCommand}" CommandParameter="{Binding SelectedNode}" />
              <Button Content="Open" Command="{Binding OpenInBrowserCommand}"
                      CommandParameter="{Binding SelectedNode}" />
              <Button Content="Copy URL" Command="{Binding CopyWebUrlCommand}"
                      CommandParameter="{Binding SelectedNode}" />
            </StackPanel>

            <Expander Header="Advanced details" Margin="0,8,0,0"
                      IsExpanded="{Binding ShowAdvancedDetails}">
              <StackPanel Spacing="4">
                <TextBlock Text="Shown for troubleshooting only. You never need to copy these."
                           Classes="Subtle" FontSize="11" />
                <TextBlock Classes="Mono" Text="{Binding SelectedNode.DriveId, StringFormat='Drive ID: {0}'}" />
                <TextBlock Classes="Mono" Text="{Binding SelectedNode.ItemId, StringFormat='Item ID: {0}'}" />
                <TextBlock Classes="Mono" Text="{Binding SelectedNode.RelativePath, StringFormat='Path: {0}'}" />
              </StackPanel>
            </Expander>
          </StackPanel>
        </StackPanel>
        </Border>

      </Grid>

      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="1" Classes="Card" Margin="0,12,0,0" Padding="4">
        <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="4"
                   Margin="8,10,8,8">
          <CheckBox Content="Include subfolders" IsChecked="{Binding IncludeSubfolders}" />
          <Button Content="Add selected as targets" Classes="Primary"
                  Command="{Binding AddSelectedAsTargetsCommand}" />
          <Button Content="Clear selection" Command="{Binding ClearSelectionCommand}" />
          <Button Content="Close other users' drives"
                  Command="{Binding CloseOtherUserDrivesCommand}"
                  IsVisible="{Binding HasOtherUserDrives}"
                  ToolTip.Tip="Closes every OneDrive except your own. Targets already added are kept."
                  AutomationProperties.Name="Close every other user's OneDrive" />
          <TextBlock VerticalAlignment="Center" Classes="Subtle"
                     Text="{Binding TargetCount, StringFormat='{}{0} target(s) in job'}" />
        </WrapPanel>
    </Border>
  </Grid>
</UserControl>
