<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>SharePointLinkManifestBuilder.Graph.Tests</RootNamespace>
    <AssemblyName>SharePointLinkManifestBuilder.Graph.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- xUnit1051: several tests deliberately pass no cancellation token, or pass their
         own, because the cancellation behaviour is what is under test. -->
    <NoWarn>$(NoWarn);CS1591;CA1707;xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/SharePointLinkManifestBuilder.Graph/SharePointLinkManifestBuilder.Graph.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
