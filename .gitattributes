# Line-ending normalization.
#
# .editorconfig mandates LF, but Git for Windows defaults to core.autocrlf=true and checks
# files out with CRLF. Without this file, `dotnet format --verify-no-changes` fails on Windows
# and only on Windows, so every Windows contributor hits it on their first clone.
#
# Text files are stored as LF in the repository and checked out as LF everywhere.

* text=auto eol=lf

# Source and configuration
*.cs        text eol=lf diff=csharp
*.axaml     text eol=lf
*.xaml      text eol=lf
*.csproj    text eol=lf
*.slnx      text eol=lf
*.props     text eol=lf
*.targets   text eol=lf
*.json      text eol=lf
*.xml       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.md        text eol=lf
*.sh        text eol=lf
*.editorconfig text eol=lf
*.gitignore text eol=lf

# Windows shell scripts genuinely need CRLF, matching .editorconfig.
*.cmd       text eol=crlf
*.bat       text eol=crlf
*.ps1       text eol=crlf

# Binary: never touched.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.icns      binary
*.pdf       binary
*.zip       binary
*.gz        binary
*.dll       binary
*.exe       binary
*.pfx       binary
*.snk       binary
*.ttf       binary
*.otf       binary
*.woff      binary
*.woff2     binary
